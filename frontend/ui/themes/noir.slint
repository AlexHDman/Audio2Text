export global Noir {
    out property <color> icon-base: #060e1c;
    out property <color> icon-rim: #31506a80;
    out property <color> night: #070c19;
    out property <color> surface: #0c1527;
    out property <color> raised: #141f36;
    out property <color> forest: #091d24;
    out property <color> edge: #28344c;
    out property <color> cyan: #48d7ff;
    out property <color> blue: #286dff;
    out property <color> teal: #50c9bc;
    out property <color> green: #50e7a4;
    out property <color> violet: #9a86f7;
    out property <color> amber: #edb463;
    out property <color> error: #e58a77;
    out property <color> ink: #f3f5fa;
    out property <color> secondary: #c5ccd7;
    out property <color> quiet: #a6b1c1;
    out property <length> radius: 12px;
    out property <length> gap: 16px;
    out property <length> small: 11px;
    out property <length> body: 13px;
    out property <length> title: 17px;
    out property <int> regular: 400;
    out property <int> medium: 500;
    out property <float> halo: 0.18;
    out property <color> backdrop-top: #060d1c;
    out property <color> backdrop-center: #050c17;
    out property <color> backdrop-bottom: #071a1b;
    out property <color> ambient-blue: #152b54;
    out property <color> ambient-violet: #322444;
    out property <color> ambient-night: #10182e;
    out property <color> floor-night: #071122;
    out property <color> floor-blue: #102847;
    out property <color> floor-end: #071222;
    out property <color> media-icon: #152742;
    out property <color> process-start: #112d50;
    out property <color> process-mid: #0c1b31;
    out property <color> process-end: #17182e;
    out property <color> track: #080f24;
    out property <color> track-edge: #285296;
    out property <color> energy-start: #1199ec;
    out property <color> energy-mid: #20beff;
    out property <color> energy-tip: #78edff;
    out property <color> energy-edge: #d5faff;
    out property <color> energy-highlight: #d7faff;
    out property <color> timer-glass: #08132590;
    out property <color> strip-start: #101d30;
    out property <color> strip-mid: #0c1b26;
    out property <color> strip-end: #11192c;
    out property <color> active-row: #142844;
    out property <color> context-start: #143142;
    out property <color> context-mid: #172e53;
    out property <color> context-end: #262341;
    out property <color> voice-surface: #16304a;
    out property <color> voice-edge: #265880;
    out property <color> language-surface: #25203d;
    out property <color> language-edge: #554083;
    out property <color> blue-clear: #286dff00;
    out property <color> journal-glass: #060d18c0;
    out property <color> scrim: #040913cf;
    out property <color> button-start: #11466b;
    out property <color> button-mid: #183b89;
    out property <color> button-end: #302b79;
    out property <color> panel-start: #162840e8;
    out property <color> panel-mid: #0a1525ed;
    out property <color> panel-end: #07171de8;
    out property <color> panel-edge: #36546c70;
    // Alpha-bearing light stops, resolved without offscreen blur passes.
    out property <color> light-blue: #2377ef70;
    out property <color> light-violet: #7653ba50;
    out property <color> light-forest: #26ab9560;
    out property <color> light-clear: #163f6800;
    out property <color> rim: #88c7ec60;
    out property <color> glow-blue: #218cff55;
    out property <color> glow-cyan: #44dfff60;
    out property <color> glow-amber: #edb46355;
    out property <color> glow-green: #50e7a440;
    out property <color> shadow: #02050b80;
}
