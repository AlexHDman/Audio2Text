import { Noir } from "../themes/noir.slint";

// Static vector masks + bounded light. No timer, animation engine or font glyphs.
export component LuminousIcon inherits Rectangle {
    in property <image> source;
    in property <color> accent: Noir.cyan;
    in property <bool> enabled: true;
    in property <bool> active: false;
    in property <bool> hovered: false;
    in property <bool> plate: true;
    width: 20px; height: 20px;
    border-radius: self.width * 0.26;
    background: plate ? Noir.icon-base : transparent;
    border-width: plate ? 1px : 0px;
    border-color: enabled && (active || hovered) ? accent.with-alpha(0.38) : Noir.icon-rim;
    Rectangle { x: -3px; y: -3px; width: parent.width + 6px; height: parent.height + 6px;
        background: @radial-gradient(circle, root.accent.with-alpha(0.38) 0%, root.accent.with-alpha(0) 68%);
        opacity: !root.enabled ? 0 : root.hovered ? 0.9 : root.active ? 0.65 : 0.18;
        animate opacity { duration: 130ms; }
    }
    Image { x: root.plate ? 2px : 0px; y: self.x; width: parent.width - self.x * 2; height: parent.height - self.y * 2;
        source: root.source; image-fit: contain;
        colorize: !root.enabled ? Noir.quiet : root.accent;
        opacity: !root.enabled ? 0.35 : root.active || root.hovered ? 1 : 0.72;
    }
}

export component StateNode inherits LuminousIcon {
    in property <string> state: "waiting";
    width: 16px; height: 16px;
    source: state == "completed" ? @image-url("../../assets/icons/success.svg") : state == "warning" ? @image-url("../../assets/icons/warning.svg") : state == "failed" ? @image-url("../../assets/icons/error.svg") : state == "active" ? @image-url("../../assets/icons/active.svg") : @image-url("../../assets/icons/waiting.svg");
    accent: state == "completed" ? Noir.green : state == "warning" ? Noir.amber : state == "failed" ? Noir.error : state == "active" ? Noir.cyan : Noir.quiet;
    active: state == "active";
    enabled: state != "waiting";
}
