import { Noir } from "../themes/noir.slint";
import { LuminousIcon } from "icons.slint";
export component GlowButton inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> has-icon: false;
    in property <bool> interrupt: false;
    in property <bool> enabled: true;
    in property <bool> primary: false;
    callback clicked(); callback hover-started(); callback hover-ended();
    property <bool> hovering: area.has-hover && root.enabled;
    changed hovering => { if hovering { hover-started(); } else { hover-ended(); } }
    min-width: 112px; min-height: 38px; border-radius: 9px;
    horizontal-stretch: 0;
    border-width: 1px;
    border-color: !enabled ? Noir.edge : hovering ? (interrupt ? Noir.error : Noir.cyan) : primary ? Noir.blue : Noir.edge;
    background: !enabled ? Noir.surface : primary ? @linear-gradient(105deg, Noir.button-start 0%, Noir.button-mid 60%, Noir.button-end 100%) : hovering ? Noir.raised : Noir.surface;
    animate background, border-color { duration: 140ms; }
    accessible-role: button; accessible-label: text; accessible-enabled: enabled;
    accessible-action-default => { if enabled { clicked(); } }
    Rectangle { x: -8px; y: -8px; width: parent.width + 16px; height: parent.height + 16px;
        background: @radial-gradient(circle, Noir.glow-blue 0%, Noir.light-clear 72%);
        opacity: root.enabled && (root.hovering || root.primary) ? (root.hovering ? 0.65 : 0.3) : 0;
        animate opacity { duration: 140ms; }
    }
    Rectangle { x: 8px; y: 0px; width: parent.width - 16px; height: 1px; background: root.primary && root.enabled ? Noir.cyan : transparent; opacity: 0.6; }
    HorizontalLayout { padding-left: 8px; padding-right: 8px; spacing: 6px; alignment: center;
        if root.has-icon: VerticalLayout { width: 20px; alignment: center;
            LuminousIcon { source: root.icon; width: 20px; height: 20px;
                enabled: root.enabled; active: root.primary; hovered: root.hovering;
                accent: root.interrupt ? (root.hovering ? Noir.error : Noir.secondary) : Noir.cyan;
            }
        }
        Text { text: root.text; color: !root.enabled ? Noir.quiet : Noir.ink; font-size: Noir.body; font-weight: Noir.medium; horizontal-alignment: center; vertical-alignment: center; }
    }
    area := TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { root.clicked(); } }
}
export component DepthPanel inherits Rectangle {
    in property <float> matte: 0.70;
    background: @linear-gradient(130deg, #101b2c.with-alpha(root.matte) 0%, #080f1c.with-alpha(root.matte) 48%, #0a1520.with-alpha(root.matte) 100%);
    border-radius: Noir.radius;
    // Matte working surface; no blur or additional compositing pass.
    border-width: 1px; border-color: #7897b133;
    Rectangle { x: 12px; y: 0px; width: parent.width - 24px; height: 1px; background: @linear-gradient(90deg, Noir.light-clear 0%, Noir.rim 30%, Noir.light-clear 100%); }
    Rectangle { x: 12px; y: parent.height - 1px; width: parent.width - 24px; height: 1px; background: Noir.shadow; }
    @children
}
export component Readout inherits Rectangle {
    in property <image> icon;
    in property <bool> live: false;
    in property <string> label;
    in property <string> value;
    in property <string> detail;
    in property <color> accent: Noir.ink;
    background: transparent;
    VerticalLayout { padding-top: 5px; padding-bottom: 5px; spacing: 3px;
        HorizontalLayout { height: 20px; spacing: 6px;
            LuminousIcon { source: root.icon; accent: root.live ? Noir.green : Noir.cyan; active: root.live; }
            Text { text: root.label; color: Noir.quiet; font-size: Noir.small; vertical-alignment: center; }
            Rectangle { horizontal-stretch: 1; background: transparent; }
        }
        Text { text: root.value; color: root.accent; font-size: 16px; overflow: elide; }
        Text { text: root.detail; color: Noir.secondary; font-size: 10px; overflow: elide; }
    }
}
